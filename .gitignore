# --- Uploaded files (runtime data, not source) ---
backend/uploads/

# --- IDE local state (per-machine, not shared) ---
**/.idea/

# --- Generated logs (per-machine, not source) ---
**/*.log

# --- Hallmark working files and local tools (per-machine, not source) ---
.hallmark/

# --- Installed agent skills, restored from skills-lock.json (third-party, not source) ---
.agents/
.claude/skills/
.claude/*.lock
